{
    "name": "web",
    "projectType": "application",
    "sourceRoot": "web",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sdk:build:wasm"
            ],
            "options": {
                "command": "npm install && npm run build",
                "cwd": "web"
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "sdk:build:wasm"
            ],
            "options": {
                "command": "npm install && npm run dev",
                "cwd": "web"
            }
        }
    }
}